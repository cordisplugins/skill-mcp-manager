{
  "name": "skill-mcp-manager",
  "description": "Skills and MCP servers for ACRYL Blends apps: a Settings page that lists, adds, switches and tests them, and MCP servers loaded only when the agent needs them. A port of alone-tree/dsh-skill-mcp-manager 1.2.2 (MIT).",
  "version": "1.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordisplugins/skill-mcp-manager.git"
  },
  "homepage": "https://github.com/cordisplugins/skill-mcp-manager",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "dist/server.js",
    "client/client.js",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "cordis",
    "cordis-plugin",
    "acrylblends",
    "dsh",
    "mcp",
    "skill",
    "settings"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cross-spawn": "^7.0.6",
    "esbuild": "0.25.10",
    "yaml": "^2.5.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.1"
  },
  "scripts": {
    "build": "esbuild lib/index.js --bundle --platform=node --target=node22 --format=esm '--external:@deepseek-ai/*' --external:yaml --external:react \"--banner:js=import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=dist/server.js"
  }
}
